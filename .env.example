# Copy to `.env` and adjust. Every variable is OPTIONAL: defaults live in config/config.yaml.

# --- Profile selection (keys under `profiles:` in config/config.yaml) ---
# local (default) | ci (longer timeouts)
QA_PROFILE=local

# --- Overrides (take precedence over YAML + profile) ---
# QA_BASE_URL=https://www.saucedemo.com
# QA_BROWSER=chromium              # chromium | firefox | webkit
# QA_HEADLESS=true                 # true | false (strict: typos error out)
# QA_SLOWMO_MS=0
# QA_LOCALE=en-US
# QA_TIMEZONE=UTC
# QA_TIMEOUT_DEFAULT_MS=10000
# QA_TIMEOUT_NAV_MS=30000

# --- Credentials (defaults are the demo store's published practice account) ---
# QA_USERNAME=standard_user
# QA_PASSWORD=

# --- Data-driven test source (JSON / YAML / CSV) ---
# QA_ORDERS=data/orders.json        # orders for the order-total tests

# --- Live e2e is opt-in ---
# QA_RUN_E2E=1
